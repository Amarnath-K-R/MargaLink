# Local secrets for `npm run dev:full` (wrangler pages dev). Copy to
# .dev.vars (gitignored) and fill in what you need; everything is optional
# for working on the UI. CLAUDE.md's "Environment variables" table explains
# each one. Never commit real values.

# The two AI features (review, Ask Claude). Without it they return an error.
ANTHROPIC_API_KEY=

# Sign-in. On localhost, DEV_EMAIL_LOG=1 prints email sign-in links to the
# console instead of sending them, so Resend isn't needed.
DEV_EMAIL_LOG=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8788/api/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=

# Payments (Paddle sandbox).
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_IDS=
